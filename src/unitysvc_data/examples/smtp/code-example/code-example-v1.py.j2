import smtplib
from email.mime.text import MIMEText

{% if local_testing %}
smtp_host = "{{ host }}"
smtp_port = {{ port | default(587) }}
use_ssl = "{{ tls | default(false) }}".lower() == "true"
username = "{{ username | default('') }}"
password = "{{ password | default('') }}"
{% else %}
import os
from urllib.parse import urlparse

# The gateway appends an "@<channel>" selector to service_base_url for
# multi-channel services (e.g. smtp://host:587@byok). Strip it before parsing,
# otherwise urlparse reads "host:587" as userinfo and "byok" as the host.
_raw = "{{ service_base_url }}"
_scheme, _sep, _rest = _raw.partition("://")
_authority = _rest.split("/", 1)[0].rsplit("@", 1)[0]
parsed = urlparse(f"{_scheme}://{_authority}" if _sep else _raw)
smtp_host = parsed.hostname
smtp_port = parsed.port or 587
use_ssl = parsed.scheme == "smtps"
username = "{{ routing_key.username }}"
password = os.environ["UNITYSVC_API_KEY"]
{% endif %}

msg = MIMEText("Hello from UnitySVC SMTP Gateway!")
msg["Subject"] = "Test Email via SMTP Gateway"
msg["From"] = "test@example.com"
msg["To"] = "recipient@example.com"

cls = smtplib.SMTP_SSL if use_ssl else smtplib.SMTP
with cls(smtp_host, smtp_port, timeout=10) as server:
    if not use_ssl:
        server.ehlo()
        if server.has_extn("STARTTLS"):
            server.starttls()
            server.ehlo()
    if username and password:
        server.login(username, password)
    server.send_message(msg)
print("connectivity ok")
