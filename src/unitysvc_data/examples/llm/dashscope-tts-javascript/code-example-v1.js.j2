async function main() {
  const response = await fetch("{{ service_base_url }}", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${process.env.UNITYSVC_API_KEY}`,
    },
    body: JSON.stringify({"model": "{{ routing_key.model }}", "input": {"text": "Hello from UnitySVC"}, "parameters": {"voice": "Cherry"}}),
  });
  if (!response.ok) {
    throw new Error(`HTTP ${response.status}: ${await response.text()}`);
  }
  const data = await response.json();
  console.log(data.output.audio.url);
{%- if not customer_display %}
  if (!data.output?.audio?.url) {
      throw new Error("no audio url in the reply");
    }
{%- endif %}
}

main().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
