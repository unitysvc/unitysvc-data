async function main() {
  const response = await fetch("{{ service_base_url }}", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${process.env.UNITYSVC_API_KEY}`,
    },
    body: JSON.stringify({"model": "{{ routing_key.model }}", "input": {"texts": ["hello world"]}}),
  });
  if (!response.ok) {
    throw new Error(`HTTP ${response.status}: ${await response.text()}`);
  }
  const data = await response.json();
  console.log(data.output.embeddings[0].embedding.length);
{%- if not customer_display %}
  if (!data.output?.embeddings?.length) {
      throw new Error("no embeddings in the reply");
    }
{%- endif %}
}

main().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
