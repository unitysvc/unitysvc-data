import os

import requests

response = requests.post(
    "{{ service_base_url }}",
    headers={
        "Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}",
        "Content-Type": "application/json",
    },
    json={"model": "{{ routing_key.model }}", "input": {"texts": ["hello world"]}},
)
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
data = response.json()
print(len(data["output"]["embeddings"][0]["embedding"]))
{%- if not customer_display %}
if not data.get("output", {}).get("embeddings"):
    raise SystemExit("no embeddings in the reply")
{%- endif %}
