#!/bin/bash
# Anthropic-format messages example for an anthropic->openai service: the
# customer speaks Anthropic; the upstream is OpenAI.
#
#   local_testing : call the OpenAI UPSTREAM directly (chat-completions) —
#                   no gateway, no translation.
#   otherwise     : call the gateway in Anthropic format; it translates to the
#                   OpenAI upstream and back.
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

{% if local_testing %}
response=$(curl --fail-with-body -sS "{{ service_base_url }}${__version_prefix__}/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d '{
    "model": "{{ routing_key.model }}",
    "messages": [
      {"role": "system", "content": "You are a helpful assistant."},
      {"role": "user", "content": "Say this is a test"}
    ]
  }')

echo "$response"

# A 2xx does not mean the call did what you asked: an error object, or a
# reply from a different capability, also returns 200. Assert the reply
# really is a chat completion before treating this as success.
if ! printf '%s' "$response" | grep -q '"choices"'; then
  echo 'unexpected response: no "choices" in the reply' >&2
  exit 1
fi
echo "example ok"
{% else %}
response=$(curl --fail-with-body -sS "{{ service_base_url }}/v1/messages" \
  -H "Content-Type: application/json" \
  -H "x-api-key: ${UNITYSVC_API_KEY}" \
  -H "anthropic-version: 2023-06-01" \
  -d '{
    "model": "{{ routing_key.model }}",
    "max_tokens": 64,
    "messages": [{"role": "user", "content": "Say this is a test"}]
  }')

echo "$response"

# The gateway replies in the dialect YOU sent, regardless of what the
# upstream speaks — so assert the reply is a Anthropic message, the caller's shape.
if ! printf '%s' "$response" | grep -q '"content"'; then
  echo 'unexpected response: no "content" in the reply' >&2
  exit 1
fi
echo "example ok"
{% endif %}
