# Streaming Anthropic-format example for an anthropic->openai translation
# service, using the official SDKs (SSE; a distinct gateway path).
#
#   local_testing : stream from the OpenAI UPSTREAM directly with the OpenAI SDK.
#   otherwise     : stream from the gateway in Anthropic format with the Anthropic
#                   SDK; the gateway translates the OpenAI stream into Anthropic
#                   content_block_delta events.
import os

{% if local_testing %}
from openai import OpenAI

client = OpenAI(
    base_url="{{ service_base_url }}${__version_prefix__}",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
stream = client.chat.completions.create(
    model="{{ routing_key.model }}",
    stream=True,
    messages=[
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Say this is a test"},
    ],
)
{%- if not customer_display %}
received = 0
{%- endif %}
for chunk in stream:
    # A chunk need not carry a choice: with stream_options.include_usage the
    # OpenAI API closes the stream with a usage-only chunk whose choices is [],
    # and some compatible providers send that chunk whether you asked or not.
    if not chunk.choices:
        continue
    delta = chunk.choices[0].delta.content
    if delta:
{%- if not customer_display %}
        received += len(delta)
{%- endif %}
        print(delta, end="", flush=True)
print()
{%- if not customer_display %}
if not received:
    raise SystemExit(
        "the stream produced no content — the upstream may have ignored stream=True"
    )
{%- endif %}
{% else %}
from anthropic import Anthropic

client = Anthropic(
    base_url="{{ service_base_url }}",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
with client.messages.stream(
    model="{{ routing_key.model }}",
    max_tokens=64,
    messages=[{"role": "user", "content": "Say this is a test"}],
) as stream:
{%- if not customer_display %}
    received = 0
{%- endif %}
    for text in stream.text_stream:
{%- if not customer_display %}
        received += len(text)
{%- endif %}
        print(text, end="", flush=True)
print()
{%- if not customer_display %}
if not received:
    raise SystemExit(
        "the stream produced no text — the upstream may have ignored stream=True"
    )
{%- endif %}
{% endif %}
