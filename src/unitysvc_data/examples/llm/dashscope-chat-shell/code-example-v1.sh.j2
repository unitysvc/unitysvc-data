#!/bin/bash
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

response=$(curl --fail-with-body -sS "{{ service_base_url }}" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d '{"model": "{{ routing_key.model }}", "input": {"messages": [{"role": "user", "content": [{"text": "Say this is a test"}]}]}, "parameters": {"max_tokens": 64}}')

echo "$response"
{%- if not customer_display %}
# DashScope answers 200 with an error envelope, so the status alone proves
# nothing -- check the payload actually carries a result.
if ! printf '%s' "$response" | grep -q '"choices"'; then
  echo 'unexpected response: no "choices" in the reply' >&2
  exit 1
fi
{%- endif %}
