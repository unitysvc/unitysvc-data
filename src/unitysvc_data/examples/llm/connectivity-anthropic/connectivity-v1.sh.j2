#!/bin/bash
# Anthropic Messages API connectivity probe: POST a one-token message
# against the rendered model and assert the gateway returned a real
# ``content`` array. Cheap, with a non-zero exit on any 4xx/5xx.
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

response=$(curl --fail-with-body -sS "{{ service_base_url }}/v1/messages" \
  -H "Content-Type: application/json" \
  -H "x-api-key: ${UNITYSVC_API_KEY}" \
  -H "anthropic-version: 2023-06-01" \
  -d '{"model":"{{ routing_key.model }}","max_tokens":1,"messages":[{"role":"user","content":"ping"}]}')

echo "$response"

{%- if not customer_display %}
if ! printf '%s' "$response" | grep -q '"content"'; then
  echo 'unexpected response: no "content" in the reply' >&2
  exit 1
fi
{%- endif %}
