const { OpenAI } = require("openai");

const client = new OpenAI({
  baseURL: "{{ service_base_url }}${__version_prefix__}",
  apiKey: process.env.UNITYSVC_API_KEY,
});

async function main() {
  const stream = await client.chat.completions.create({
    model: "{{ routing_key.model }}",
{% if "${__max_tokens__}" %}
    max_tokens: ${__max_tokens__},
{% endif %}
    messages: [
      { role: "system", content: "You are a helpful assistant." },
      { role: "user", content: "Say this is a test" },
    ],
    stream: true,
  });
{%- if not customer_display %}
  let received = 0;
{%- endif %}
  for await (const chunk of stream) {
    const delta = chunk.choices[0]?.delta?.content;
    if (delta) {
{%- if not customer_display %}
      received += delta.length;
{%- endif %}
      process.stdout.write(delta);
    }
  }
  process.stdout.write("\n");
{%- if not customer_display %}
  if (!received) {
    throw new Error(
      "the stream produced no content — the upstream may have ignored stream: true"
    );
  }
{%- endif %}
}

main().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
