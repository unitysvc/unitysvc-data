[
  {
    "format": "openai",
    "path_suffix": "${__version_prefix__}/embeddings",
    "body": {
      "input": [
        "Embed this sentence.",
        "As well as this one."
      ]
    }
  },
  {
    "format": "cohere",
    "path_suffix": "${__version_prefix__}/embed",
    "body": {
      "input_type": "image",
      "embedding_types": [
        "float"
      ],
      "images": [
        "data:image/jpeg;base64,"
      ]
    }
  },
  {
    "format": "dashscope",
    "body": {
      "input": {
        "texts": [
          "hello world"
        ]
      }
    }
  },
  {
    "format": "huggingface",
    "body": {
      "inputs": {
        "source_sentence": "I love machine learning",
        "sentences": [
          "I enjoy studying AI",
          "The weather is nice today",
          "Deep learning is fascinating"
        ]
      }
    }
  }
]
