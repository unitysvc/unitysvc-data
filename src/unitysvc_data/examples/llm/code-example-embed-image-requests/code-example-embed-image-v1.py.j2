import os
import urllib.request

import requests

image_url = os.environ.get(
    "IMAGE_URL",
    "https://raw.githubusercontent.com/unitysvc/unitysvc-data/main/src/unitysvc_data/examples/llm/test-image.jpg",
)

import base64
import mimetypes

with urllib.request.urlopen(image_url, timeout=30) as resp:
    image_bytes = resp.read()
mime, _ = mimetypes.guess_type(image_url)
mime = mime or "image/jpeg"
data_uri = f"data:{mime};base64,{base64.b64encode(image_bytes).decode()}"

response = requests.post(
    "{{ service_base_url }}${__version_prefix__}/embed",
    headers={
        "Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}",
        "Content-Type": "application/json",
    },
    json={
        "model": "{{ routing_key.model }}",
        "input_type": "image",
        "embedding_types": ["float"],
        "images": [data_uri],
    },
)
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
data = response.json()
embedding = data["embeddings"]["float"][0]
print(f"got embedding of dimension {len(embedding)}")
