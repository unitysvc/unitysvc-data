#!/bin/bash
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

image_url="${IMAGE_URL:-https://raw.githubusercontent.com/unitysvc/unitysvc-data/main/src/unitysvc_data/examples/llm/test-image.jpg}"
image_file="$(basename "${image_url%%\?*}")"
[ -f "${image_file}" ] || curl -sSL --fail-with-body -o "${image_file}" "${image_url}"

mime=$(file --mime-type -b "${image_file}" 2>/dev/null || echo "image/jpeg")
data_uri="data:${mime};base64,$(base64 < "${image_file}" | tr -d '\n')"

response=$(curl --fail-with-body -sS "{{ service_base_url }}${__version_prefix__}/embed" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d "{
    \"model\": \"{{ routing_key.model }}\",
    \"input_type\": \"image\",
    \"embedding_types\": [\"float\"],
    \"images\": [\"${data_uri}\"]
  }")

echo "$response"

# A 2xx does not mean the call did what you asked: an error object, or a
# reply from a different capability, also returns 200. Assert the reply
# really is a embeddings array before treating this as success.
if ! printf '%s' "$response" | grep -q '"embeddings"'; then
  echo 'unexpected response: no "embeddings" in the reply' >&2
  exit 1
fi
echo "example ok"
