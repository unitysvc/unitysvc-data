#!/bin/bash
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

prompt="${PROMPT:-An astronaut riding a horse on Mars}"
output_file="${OUTPUT_FILE:-image.png}"

response=$(curl --fail-with-body -sS "{{ service_base_url }}${__version_prefix__}/images/generations" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d "{
    \"model\": \"{{ routing_key.model }}\",
    \"prompt\": \"${prompt}\",
    \"n\": 1,
    \"size\": \"1024x1024\",
    \"response_format\": \"b64_json\"
  }")

python3 -c "
import base64, json, sys
data = json.loads(sys.stdin.read())
with open('${output_file}', 'wb') as f:
    f.write(base64.b64decode(data['data'][0]['b64_json']))
" <<< "${response}"

echo "Saved ${output_file}"

# A 2xx does not mean the call did what you asked: an error object, or a
# reply from a different capability, also returns 200. Assert the reply
# really is a image payload before treating this as success.
if ! printf '%s' "$response" | grep -q '"data"'; then
  echo 'unexpected response: no "data" in the reply' >&2
  exit 1
fi
echo "example ok"
