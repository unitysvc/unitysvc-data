import os

import requests

response = requests.post(
    "{{ service_base_url }}",
    headers={
        "Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}",
        "Content-Type": "application/json",
    },
    json={"model": "{{ routing_key.model }}", "input": {"text": "Hello from UnitySVC"}, "parameters": {"voice": "Cherry"}},
)
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
data = response.json()
print(data["output"]["audio"]["url"])
{%- if not customer_display %}
if not data.get("output", {}).get("audio", {}).get("url"):
    raise SystemExit("no audio url in the reply")
{%- endif %}
