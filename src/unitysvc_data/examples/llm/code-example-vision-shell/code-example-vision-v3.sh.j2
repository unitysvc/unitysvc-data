#!/bin/bash
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

image_url="${IMAGE_URL:-https://raw.githubusercontent.com/unitysvc/unitysvc-data/main/src/unitysvc_data/examples/llm/test-image.jpg}"
prompt="${PROMPT:-Describe this image.}"

# Fetch the image HERE and inline it as a data URI, rather than handing the
# model a URL and letting it fetch the bytes itself. Server-side fetching is
# the provider's network, not yours: some cannot reach an arbitrary host at
# all, and others manage it only most of the time, so the call fails with a
# download error that has nothing to do with your request. Inlining removes
# that dependency — the only fetch is this one, and it either works or fails
# where you can see it.
#
# To send your own local image instead, drop the curl and read the file:
#   media_type="image/jpeg"; image_b64=$(base64 < ./my-image.jpg | tr -d '\n')
tmp_image=$(mktemp)
trap 'rm -f "$tmp_image"' EXIT
media_type=$(curl --fail-with-body -sS -o "$tmp_image" -w '%{content_type}' "$image_url")
# `base64` wraps output on GNU but not BSD; strip newlines so both produce one line.
image_b64=$(base64 < "$tmp_image" | tr -d '\n')

response=$(curl --fail-with-body -sS "{{ service_base_url }}${__version_prefix__}/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d "{
    \"model\": \"{{ routing_key.model }}\",
    \"messages\": [
      {
        \"role\": \"user\",
        \"content\": [
          {\"type\": \"text\", \"text\": \"${prompt}\"},
          {\"type\": \"image_url\", \"image_url\": {\"url\": \"data:${media_type};base64,${image_b64}\"}}
        ]
      }
    ]
  }")

echo "$response"

# A 2xx does not mean the call did what you asked: an error object, or a
# reply from a different capability, also returns 200. Assert the reply
# really is a chat completion before treating this as success.
if ! printf '%s' "$response" | grep -q '"choices"'; then
  echo 'unexpected response: no "choices" in the reply' >&2
  exit 1
fi
echo "example ok"
