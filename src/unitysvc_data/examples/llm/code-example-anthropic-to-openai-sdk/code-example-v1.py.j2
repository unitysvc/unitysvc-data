# Anthropic-format example for an anthropic->openai translation service, using
# the official SDKs (clearer than raw requests; needs both SDKs installed).
#
#   local_testing : call the OpenAI UPSTREAM directly with the OpenAI SDK.
#   otherwise     : call the gateway in Anthropic format with the Anthropic SDK;
#                   the gateway translates to the OpenAI upstream and back.
import os

{% if local_testing %}
from openai import OpenAI

client = OpenAI(
    base_url="{{ service_base_url }}${__version_prefix__}",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
response = client.chat.completions.create(
    model="{{ routing_key.model }}",
    messages=[
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Say this is a test"},
    ],
)
print(response.choices[0].message.content)
{% else %}
from anthropic import Anthropic

client = Anthropic(
    base_url="{{ service_base_url }}",
    api_key=os.environ["UNITYSVC_API_KEY"],
)
message = client.messages.create(
    model="{{ routing_key.model }}",
    max_tokens=64,
    messages=[{"role": "user", "content": "Say this is a test"}],
)
# content[0] may be a thinking block (reasoning models) rather than a text
# block, so print the block itself instead of assuming a .text attribute.
print(message.content[0])
{% endif %}
