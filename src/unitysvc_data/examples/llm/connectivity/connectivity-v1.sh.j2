#!/bin/bash
# LLM connectivity probe: POST a one-token chat completion against the
# rendered model and assert the gateway returned a real ``choices``
# array. Cheap, with a non-zero exit on any 4xx / 5xx.
set -e -o pipefail

: "${UNITYSVC_API_KEY:?UNITYSVC_API_KEY is not set}"

response=$(curl --fail-with-body -sS "{{ service_base_url }}${__version_prefix__}/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ${UNITYSVC_API_KEY}" \
  -d '{"model":"{{ routing_key.model }}","messages":[{"role":"user","content":"ping"}],"max_tokens":1}')

echo "$response"

{%- if not customer_display %}
if ! printf '%s' "$response" | grep -q '"choices"'; then
  echo 'unexpected response: no "choices" in the reply' >&2
  exit 1
fi
{%- endif %}
