import os

import requests

response = requests.post(
    "{{ service_base_url }}${__version_prefix__}/models/{{ routing_key.model }}",
    headers={
        "Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}",
        "Content-Type": "application/json",
    },
    json={
        "inputs": {
            "source_sentence": "I love machine learning",
            "sentences": [
                "I enjoy studying AI",
                "The weather is nice today",
                "Deep learning is fascinating",
            ],
        }
    },
)
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
print(response.json())
