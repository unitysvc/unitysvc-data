import os

import requests

image_url = os.environ.get(
    "IMAGE_URL",
    "https://raw.githubusercontent.com/unitysvc/unitysvc-data/main/src/unitysvc_data/examples/llm/test-image.jpg",
)
prompt = os.environ.get("PROMPT", "Describe this image.")

response = requests.post(
    "{{ service_base_url }}${__version_prefix__}/chat/completions",
    headers={
        "Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}",
        "Content-Type": "application/json",
    },
    json={
        "model": "{{ routing_key.model }}",
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {"type": "image_url", "image_url": {"url": image_url}},
                ],
            }
        ],
    },
)
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
print(response.json()["choices"][0]["message"]["content"])
