import os

import httpx

{% if local_testing %}
# Local mode: POST OpsGenie payload directly to the upstream endpoint.
WEBHOOK_URL = "{{ service_base_url }}${{'__webhook_path__'}}"

response = httpx.post(
    WEBHOOK_URL,
    json={"message":"connectivity check","description":"ping"},
)
{%- if not customer_display %}
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
{%- endif %}
{% else %}
# Gateway mode: POST the notification payload to the UnitySVC gateway.
GATEWAY_URL = "{{ service_base_url }}"

response = httpx.post(
    GATEWAY_URL,
    headers={"Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}"},
    json={
            "message": "connectivity check",
            "description": "ping"
        },
)
{%- if not customer_display %}
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
{%- endif %}
{% endif %}
