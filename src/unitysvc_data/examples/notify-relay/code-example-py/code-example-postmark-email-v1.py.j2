import os

import httpx

{% if local_testing %}
# Local mode: POST Postmark payload directly to the upstream endpoint.
WEBHOOK_URL = "{{ service_base_url }}${{'__webhook_path__'}}"

response = httpx.post(
    WEBHOOK_URL,
    json={"From":"test@example.com","To":"test@example.com","Subject":"connectivity check","TextBody":"ping"},
)
{%- if not customer_display %}
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
{%- endif %}
{% else %}
# Gateway mode: POST the notification payload to the UnitySVC gateway.
GATEWAY_URL = "{{ service_base_url }}"

response = httpx.post(
    GATEWAY_URL,
    headers={"Authorization": f"Bearer {os.environ['UNITYSVC_API_KEY']}"},
    json={
            "From": "test@example.com",
            "To": "test@example.com",
            "Subject": "connectivity check",
            "TextBody": "ping"
        },
)
{%- if not customer_display %}
if response.status_code >= 400:
    raise RuntimeError(f"HTTP {response.status_code} from {response.url}: {response.text}")
{%- endif %}
{% endif %}
